{
  "name": "pocket-memory",
  "version": "0.1.0",
  "private": true,
  "description": "A text-first personal memory capture API.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=.env --import tsx database/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "fastify": "^5.0.0",
    "openai": "^7.32.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
