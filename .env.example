# PostgreSQL connection string for the existing PostgreSQL server.
DATABASE_URL=

# Network address and port for this API.
HOST=
PORT=

# AI enrichment is optional. Set to disabled to store raw notes only.
MEMORY_ENRICHMENT_PROVIDER=
MEMORY_ENRICHMENT_MODEL=
MEMORY_ENRICHMENT_BASE_URL=

# Local Whisper (OpenAI-compatible) container settings.
WHISPER_BASE_URL=
WHISPER_API_KEY=replace-with-local-whisper-key
WHISPER_MODEL=
AUDIO_STORAGE_DIR=
OBSIDIAN_VAULT_PATH=